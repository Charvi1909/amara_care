# Copy this file to  backend/.env  and fill in the real values.
# backend/.env is git-ignored on purpose — never commit real keys.
#
# Ask Manya for the actual values, or copy them from her backend/.env.

# Supabase — project URL + a key with server-side access.
# (The browser uses the public anon key, already hard-coded in
#  frontend/supabaseClient.js. This one is for the Node server.)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-key

# Google AI Studio — https://aistudio.google.com/apikey
# Used by the chaos extractor and the "Ask AI" tab.
GEMINI_API_KEY=your-gemini-api-key

# Resend — https://resend.com/api-keys   (optional)
# Only the emergency-escalation emails need this. Leave blank to skip them.
RESEND_API_KEY=your-resend-api-key

# Optional — only matters in production (Vercel). The base URL of the deployed
# site, so the "I've got this" links in emergency emails are clickable.
# PUBLIC_BASE_URL=https://amara-care.vercel.app

# Optional — where the "Ask AI" tab searches when a question names no place.
# DEMO_LOCATION=Vellore
# DEMO_COUNTRY_CODE=in
